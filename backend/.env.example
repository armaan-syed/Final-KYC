# AWS
AWS_REGION=us-east-1

# Database (RDS PostgreSQL)
RDS_HOST=localhost
RDS_PORT=5432
RDS_DB_NAME=pramana_kyc
RDS_USERNAME=postgres
RDS_PASSWORD=local-only-change-this-value
# In AWS, use the RDS-managed Secrets Manager ARN instead of RDS_PASSWORD.
RDS_SECRET_ARN=

# Cognito - Customer Pool
COGNITO_CUSTOMER_POOL_ID=us-east-1_XXXXXXXXX
# Cognito - Reviewer Pool
COGNITO_REVIEWER_POOL_ID=us-east-1_YYYYYYYYY
# Cognito App Client ID (customer pool client)
COGNITO_APP_CLIENT_ID=zzzzzzzzzzzzzzzzzzzzzzzz
# Cognito App Client ID (reviewer pool client)
COGNITO_REVIEWER_APP_CLIENT_ID=zzzzzzzzzzzzzzzzzzzzzzzz

# S3 Document Storage
S3_DOCUMENTS_BUCKET=pramana-kyc-documents

# SQS Queue for OCR Worker
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/pramana-kyc-ocr-queue

# SES Sender Email
# Replace with an address belonging to a verified SES identity before sending.
SES_SENDER_EMAIL=verified-sender@example.com

# API
API_BASE_URL=http://localhost:8000
