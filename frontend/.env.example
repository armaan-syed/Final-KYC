# Pramāṇa Frontend Environment Configuration
# Replace these placeholder values with deployed AWS and API Gateway identifiers from Person A & B.
# Do not commit real production credentials or IAM keys to version control.

# FastAPI / API Gateway Base URL (Person B)
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# AWS Region (Person A)
NEXT_PUBLIC_AWS_REGION=ap-south-1

# Cognito Customer User Pool & Client (Person A)
NEXT_PUBLIC_COGNITO_CUSTOMER_USER_POOL_ID=ap-south-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CUSTOMER_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Cognito Reviewer User Pool & Client (Person A)
NEXT_PUBLIC_COGNITO_REVIEWER_USER_POOL_ID=ap-south-1_YYYYYYYYY
NEXT_PUBLIC_COGNITO_REVIEWER_CLIENT_ID=yyyyyyyyyyyyyyyyyyyyyyyyyy

# Set to "true" to use local mock data adapters for frontend testing without AWS backend
NEXT_PUBLIC_USE_MOCKS=false
